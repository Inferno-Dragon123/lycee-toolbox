{
  "name": "js",
  "version": "1.0.0",
  "description": "",
  "main": "wenjian.js",
  "scripts": {
    "start": "node scripts/server.js",
    "dev": "node scripts/dev-server.js",
    "build": "node scripts/check-catalog.js && node scripts/build-frontend.js",
    "test": "node --test tests/*.test.js",
    "test:python": "python -m unittest discover -s tests -p test_*.py",
    "db:migrate": "node scripts/migrate.js",
    "auth:migrate": "node scripts/migrate-local-auth.js",
    "auth:export": "node scripts/export-neon-auth-users.js",
    "auth:import": "node scripts/import-neon-auth-users.js",
    "catalog:build": "python scripts/build_catalog.py",
    "predev": "node scripts/build-frontend.js",
    "decks:sync": "node scripts/sync-official-decks.js",
    "update:full": "python scripts/update_and_translate.py --catalog",
    "update:dry-run": "python scripts/update_and_translate.py --dry-run",
    "update:translate-only": "python scripts/update_and_translate.py --skip-crawl",
    "update:no-git": "python scripts/update_and_translate.py --catalog --no-git",
    "test:update": "python -m unittest discover -s tests -p test_update_and_translate.py"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": { "node": ">=24" },
  "dependencies": {
    "@neondatabase/auth": "0.5.0-beta",
    "@upstash/redis": "^1.38.0",
    "@vercel/functions": "^3.9.9",
    "@vercel/kv": "^2.0.0",
    "axios": "^1.18.1",
    "better-auth": "1.7.7",
    "cheerio": "^1.2.0",
    "docx": "^9.6.1",
    "dotenv": "^17.4.2",
    "jspdf": "^4.2.1",
    "nodemailer": "10.0.14",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "puppeteer": "^25.3.0",
    "robots-parser": "^3.0.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "esbuild": "^0.28.2"
  }
}
