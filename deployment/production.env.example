# lycee-managed: production environment v1. Root-owned, group lycee-production, 0640.
# Replace ALL placeholders locally. Never upload .env in release tarballs or CI artifacts.
NODE_ENV=production
HOST=127.0.0.1
TRUST_PROXY=loopback
PORT=3100
SITE_ORIGIN=https://lycee-toolbox.top
AUTH_PROVIDER=better-auth
BETTER_AUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
DATABASE_URL=postgresql://lycee_production:REPLACE_PASSWORD@127.0.0.1:5432/lycee_production
DATABASE_URL_UNPOOLED=postgresql://lycee_production:REPLACE_PASSWORD@127.0.0.1:5432/lycee_production
IMAGE_STORAGE_DIR=/var/lib/lycee/images
IMAGE_PUBLIC_ORIGIN=https://lycee-toolbox.top
PDF_CONCURRENCY=1
SMTP_HOST=REPLACE_WITH_EMAIL_PROVIDER_HOST
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REPLACE_USER
SMTP_PASS=REPLACE_PASSWORD
SMTP_FROM=REPLACE_VERIFIED_SENDER
COMMUNITY_ADMIN_IDS=
