# lycee-managed: official deck maintenance v1 (disabled until cutover)
[Unit]
Description=Sync Lycee official public decks to local production database
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=lycee-production
Group=lycee-production
WorkingDirectory=/opt/lycee/instances/production/current
EnvironmentFile=/etc/lycee/instances/production.env
ExecStart=/usr/local/lib/lycee/maintenance.sh
ReadWritePaths=/var/lib/lycee/production
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
Nice=10
MemoryMax=512M
CPUQuota=50%
TimeoutStartSec=35min
UMask=0027
