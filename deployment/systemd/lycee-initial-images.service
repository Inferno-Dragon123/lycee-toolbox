# lycee-managed: resumable initial image mirror v1
[Unit]
Description=Complete initial Lycee card image mirror with restart recovery
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/lycee/instances/production/current/scripts/mirror-card-images.js
ConditionPathExists=/etc/lycee/images.env

[Service]
Type=simple
User=lycee-assets
Group=lycee-assets
WorkingDirectory=/opt/lycee/instances/production/current
Environment=IMAGE_STORAGE_DIR=/var/lib/lycee/images
EnvironmentFile=/etc/lycee/images.env
ExecStart=/usr/local/bin/node scripts/mirror-card-images.js --all
Restart=on-failure
RestartSec=1h
ReadWritePaths=/var/lib/lycee/images
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
Nice=10
MemoryMax=384M
CPUQuota=35%
TimeoutStopSec=60
UMask=0022

[Install]
WantedBy=multi-user.target
