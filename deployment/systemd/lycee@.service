# lycee-managed: app template v1
[Unit]
Description=Lycee Toolbox (%i)
After=network.target postgresql.service
Requires=postgresql.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
User=lycee-%i
Group=lycee-%i
SupplementaryGroups=lycee-assets
WorkingDirectory=/opt/lycee/instances/%i/current
EnvironmentFile=/etc/lycee/instances/%i.env
ExecStart=/usr/local/bin/node scripts/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=130
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lycee/%i
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryHigh=320M
MemoryMax=384M
CPUQuota=30%
TasksMax=80
LimitNOFILE=2048
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lycee-%i

[Install]
WantedBy=multi-user.target
