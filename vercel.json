{
  "version": 2,
  "fluid": true,
  "rewrites": [{ "source": "/api/auth/:path*", "destination": "/api/auth?path=:path*" }],
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": "{data/catalog.json,lycee-*-database-final.json,public/fonts/NotoSansSC.ttf}"
    }
  }
}
